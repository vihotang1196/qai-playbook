# Frontend Supabase config (safe to expose — anon key is public).
# Copy this file to `.env` and fill in your project's values.
# Find them in the Supabase dashboard: Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NOTE: The Anthropic key is NOT set here. It lives only as an Edge Function
# secret on the server:  supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
